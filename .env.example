# The project billed for query jobs.
GOOGLE_CLOUD_PROJECT=your-project-id

# Comma-separated allowlist. Use curated views rather than raw source datasets.
ALLOWED_DATASETS=analytics_reporting

# Query guardrails.
MAXIMUM_BYTES_BILLED=1073741824
MAXIMUM_ROWS=500
QUERY_TIMEOUT_SECONDS=30

# Required for requests to /mcp. Store the actual value in Secret Manager.
# Used whenever the OIDC settings below are left unset.
MCP_BEARER_TOKEN=replace-with-a-long-random-token

# OAuth/OIDC verification. Leave all three unset to stay on the bearer token above.
# OIDC_ISSUER=https://your-issuer.example.com/
# OIDC_AUDIENCE=secure-bigquery-mcp-gateway
# OIDC_JWKS_URL=https://your-issuer.example.com/.well-known/jwks.json
OIDC_ROLE_CLAIM=roles

# RBAC. The bearer-token path is assigned this single role.
BEARER_TOKEN_ROLE=service
# role:dataset,dataset;role:dataset — "*" means every dataset in ALLOWED_DATASETS.
ROLE_DATASET_MAP=service:*

# Postgres connector. Leave POSTGRES_DSN unset to disable the tool entirely.
# POSTGRES_DSN=postgresql://readonly_role@localhost:5432/analytics
POSTGRES_ALLOWED_SCHEMAS=reporting
POSTGRES_MAXIMUM_ROWS=500
POSTGRES_QUERY_TIMEOUT_SECONDS=15

# REST connector. Empty host allowlist means no host is reachable.
REST_ALLOWED_HOSTS=
REST_ALLOWED_ROLES=service
REST_TIMEOUT_SECONDS=10
REST_MAX_RESPONSE_BYTES=1000000

# PII masking applied to every connector's result rows.
MASK_PII=true

# Per-identity limits (in-memory, single-instance — see README production checklist).
RATE_LIMIT_PER_MINUTE=30
DAILY_BYTE_BUDGET_PER_IDENTITY=10737418240
